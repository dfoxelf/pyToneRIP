<?xml version="1.0" encoding="utf-8"?>
<psf2:PrintDeviceCapabilities
  xmlns:psf2="http://schemas.microsoft.com/windows/2013/12/printing/printschemaframework2"
  xmlns:psf="http://schemas.microsoft.com/windows/2003/08/printing/printschemaframework"
  xmlns:psk="http://schemas.microsoft.com/windows/2003/08/printing/printschemakeywords"
  xmlns:psk12="http://schemas.microsoft.com/windows/2013/12/printing/printschemakeywordsv12"
  xmlns:ptr="https://pytone-rip.local/printticket/2026/phase12"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <psk:JobCopiesAllDocuments psf2:psftype="ParameterDef" psf2:deviceProcessed="true">
    <psf:DataType psf2:psftype="Property" xsi:type="xsd:QName">xsd:integer</psf:DataType>
    <psf:DefaultValue psf2:psftype="Property" xsi:type="xsd:integer">1</psf:DefaultValue>
    <psf:MaxValue psf2:psftype="Property" xsi:type="xsd:integer">99</psf:MaxValue>
    <psf:MinValue psf2:psftype="Property" xsi:type="xsd:integer">1</psf:MinValue>
    <psf:Multiple psf2:psftype="Property" xsi:type="xsd:integer">1</psf:Multiple>
    <psf:Mandatory psf2:psftype="Property" xsi:type="xsd:QName">psk:Unconditional</psf:Mandatory>
    <psf:UnitType psf2:psftype="Property" xsi:type="xsd:string">copies</psf:UnitType>
  </psk:JobCopiesAllDocuments>
  <psk:PageMediaSize psf2:psftype="Feature">
    <psk:ISOA4 psf2:psftype="Option" psf2:default="true">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,210000,297000</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">297000</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">210000</psk:MediaSizeWidth>
    </psk:ISOA4>
    <psk:ISOA5 psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,148000,210000</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">210000</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">148000</psk:MediaSizeWidth>
    </psk:ISOA5>
    <psk:ISOA6 psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,105000,148000</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">148000</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">105000</psk:MediaSizeWidth>
    </psk:ISOA6>
    <ptr:Page_B5 psf2:psftype="Option">
      <psk:DisplayName psf2:psftype="Property" xsi:type="xsd:string">B5</psk:DisplayName>
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,176000,250000</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">250000</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">176000</psk:MediaSizeWidth>
    </ptr:Page_B5>
    <psk:NorthAmericaLegal psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,215900,355600</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">355600</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">215900</psk:MediaSizeWidth>
    </psk:NorthAmericaLegal>
    <psk:NorthAmericaLetter psf2:psftype="Option">
      <psk12:PortraitImageableSize psf2:psftype="Property" xsi:type="psf2:ImageableAreaType">0,0,215900,279400</psk12:PortraitImageableSize>
      <psk:MediaSizeHeight psf2:psftype="ScoredProperty" xsi:type="xsd:integer">279400</psk:MediaSizeHeight>
      <psk:MediaSizeWidth psf2:psftype="ScoredProperty" xsi:type="xsd:integer">215900</psk:MediaSizeWidth>
    </psk:NorthAmericaLetter>
  </psk:PageMediaSize>
  <psk:PageMediaType psf2:psftype="Feature">
    <ptr:Media_Plain_Paper psf2:psftype="Option" psf2:default="true" />
    <ptr:Media_Plain_Paper_Fast_Load psf2:psftype="Option" />
    <ptr:Media_Postcard psf2:psftype="Option" />
    <ptr:Media_Glossy_Film psf2:psftype="Option" />
    <ptr:Media_Envelopes psf2:psftype="Option" />
    <ptr:Media_Photo_Quality_Glossy_Paper psf2:psftype="Option" />
    <ptr:Media_Matte_Paper psf2:psftype="Option" />
    <ptr:Media_Photo_Paper psf2:psftype="Option" />
  </psk:PageMediaType>
  <psk:JobInputBin psf2:psftype="Feature">
    <ptr:Input_Standard psf2:psftype="Option" psf2:default="true" />
    <ptr:Input_Manual psf2:psftype="Option" />
    <ptr:Input_Roll psf2:psftype="Option" />
  </psk:JobInputBin>
  <psk:PageOrientation psf2:psftype="Feature">
    <psk:Portrait psf2:psftype="Option" psf2:default="true" />
    <psk:Landscape psf2:psftype="Option" />
  </psk:PageOrientation>
  <psk:PageResolution psf2:psftype="Feature">
    <ptr:Dpi300x300 psf2:psftype="Option">
      <psk:ResolutionX psf2:psftype="ScoredProperty" xsi:type="xsd:integer">300</psk:ResolutionX>
      <psk:ResolutionY psf2:psftype="ScoredProperty" xsi:type="xsd:integer">300</psk:ResolutionY>
    </ptr:Dpi300x300>
    <ptr:Dpi600x600 psf2:psftype="Option" psf2:default="true">
      <psk:ResolutionX psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionX>
      <psk:ResolutionY psf2:psftype="ScoredProperty" xsi:type="xsd:integer">600</psk:ResolutionY>
    </ptr:Dpi600x600>
  </psk:PageResolution>
  <psk:PageOutputColor psf2:psftype="Feature">
    <psk:Color psf2:psftype="Option" psf2:default="true">
      <psk:DeviceBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">24</psk:DeviceBitsPerPixel>
      <psk:DriverBitsPerPixel psf2:psftype="ScoredProperty" xsi:type="xsd:integer">24</psk:DriverBitsPerPixel>
    </psk:Color>
  </psk:PageOutputColor>
</psf2:PrintDeviceCapabilities>
