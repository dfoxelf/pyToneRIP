  <Target Name="PrepareVersionedPackageManifest" BeforeTargets="_ValidatePresenceOfAppxManifestItems" Condition="'$(PackageBuildVersion)' != ''">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(PackageManifestSource)" DestinationFiles="$(VersionedPackageManifest)" />
    <XmlPoke XmlInputPath="$(VersionedPackageManifest)" Query="/*[local-name()='Package']/*[local-name()='Identity']/@Version" Value="$(PackageBuildVersion)" />
    <ItemGroup>
      <AppxManifest Remove="@(AppxManifest)" />
      <AppxManifest Include="$(VersionedPackageManifest)" />
    </ItemGroup>
  </Target>
  <Target Name="ExportPythonCapabilities" BeforeTargets="PrepareForBuild" Condition="Exists('$(PythonExecutable)') and '$(GeneratedAssetsRoot)' == ''">
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\.." Command="&quot;$(PythonExecutable)&quot; -m xp750_rip psa-export-capabilities --output &quot;$(CapabilityExport)&quot;" />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)..\.." Command="&quot;$(PythonExecutable)&quot; -m xp750_rip psa-export-pdc --output &quot;$(PdcAggregateExport)&quot; --model-output-dir &quot;$(PdcModelExport)&quot;" />
  </Target>
  <!-- The frozen Python distribution and generated printer catalog are package
       payload, not MRT/XAML resources. Keeping those files in resources.pri
       makes the first XAML InitializeComponent block for several seconds and
       also makes dots in CPython extension names look like PRI qualifiers.

       Preserve the complete items (and their package metadata), remove them
       only while the AppX targets create the PRI input lists, then restore them
       before the MSIX payload is assembled. -->
  <Target Name="ExcludeTechnicalPayloadFromPri"
          BeforeTargets="_GenerateProjectPriConfigurationFiles"
          Condition="'$(AppxPackage)' == 'true'">
    <ItemGroup>
      <_TechnicalPackagePayload Include="@(PackagingOutputs)"
          Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(PackagingOutputs.TargetPath)', '^(Runtime[\\/]|Assets[\\/](CapabilityModels|PdcModels|PdrModels)[\\/]|Assets[\\/]capabilities\.(common|generated|index)\.json$|Assets[\\/]catalog-signing\.cer$)'))" />
      <PackagingOutputs Remove="@(_TechnicalPackagePayload)" />
    </ItemGroup>
  </Target>
  <Target Name="RestoreTechnicalPayloadAfterPriInputGeneration"
          AfterTargets="_GenerateProjectPriConfigurationFiles"
          Condition="'$(AppxPackage)' == 'true'">
    <ItemGroup>
      <PackagingOutputs Include="@(_TechnicalPackagePayload)" />
    </ItemGroup>
  </Target>
