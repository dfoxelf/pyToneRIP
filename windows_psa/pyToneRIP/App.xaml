<Application x:Class="pyToneRIP.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="PageBackgroundBrush" Color="#FFF7F8FA" />
      <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFF3F5F8" />
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFFFF" />
      <SolidColorBrush x:Key="TableHeaderBrush" Color="#FFF0F2F5" />
      <SolidColorBrush x:Key="StatusBarBrush" Color="#FFE9EDF2" />
      <SolidColorBrush x:Key="SectionBorderBrush" Color="#22000000" />
      <SolidColorBrush x:Key="SecondaryTextBrush" Color="#FF5E6875" />
      <SolidColorBrush x:Key="AccentBrush" Color="#FF0078D4" />
      <SolidColorBrush x:Key="LogSuccessBrush" Color="#FF147A4A" />
      <SolidColorBrush x:Key="LogWarningBrush" Color="#FF9A6500" />
      <SolidColorBrush x:Key="LogErrorBrush" Color="#FFB42318" />
      <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
      <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
