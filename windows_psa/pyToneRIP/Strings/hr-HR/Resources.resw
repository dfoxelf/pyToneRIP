  <data name="Auto.55EB8098D769.Header"><value>Logički ID-ovi tinte (slova, znamenke, zarezi)</value></data>
  <data name="Auto.55EB8098D769.PlaceholderText"><value>K,C,M</value></data>
  <data name="Auto.5C063BCAA06D.Header"><value>IPv4 adresa</value></data>
