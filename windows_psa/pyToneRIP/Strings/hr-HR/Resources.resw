  <data name="Auto.A017CBDCAD04.Text"><value>Svi tonovi</value></data>
  <data name="Auto.A05E7E6FDDCE.Text"><value>Pokreće jedan standardni ciklus čišćenja. Čišćenje troši tintu.</value></data>
  <data name="Auto.A1E29BE24CE4.Text"><value>Vrsta medija</value></data>
  <data name="Auto.A5C0DF7110EB.Text"><value>Izgled</value></data>
  <data name="Auto.ABC04E88801E.Content"><value>Provjera ispisnih mlaznica</value></data>
  <data name="Auto.AD3F950D9853.Text"><value>Plasman</value></data>
  <data name="Auto.AE6F3FB9819E.Text"><value>Logički kanal → PhysicalPath</value></data>
  <data name="Auto.AF02B8100196.Text"><value>Orijentacija</value></data>
  <data name="Auto.AF70020B40EA.Content"><value>primijeniti</value></data>
